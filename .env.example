# Zen-gineering - Configuration d'environnement
# Copiez ce fichier en .env et modifiez les valeurs selon votre environnement

# ==========================================
# Application
# ==========================================
NODE_ENV=development
APP_NAME=Zen-gineering
APP_URL=http://localhost:3001
API_URL=http://localhost:3000

# ==========================================
# PostgreSQL
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=zengineering
POSTGRES_USER=zengineering
POSTGRES_PASSWORD=change_me_in_production

# ==========================================
# MongoDB
# ==========================================
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=zengineering
MONGO_USER=zengineering
MONGO_PASSWORD=change_me_in_production

# ==========================================
# Redis
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_production

# ==========================================
# Elasticsearch
# ==========================================
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# ==========================================
# MinIO / S3
# ==========================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production
MINIO_BUCKET_NAME=zengineering-files
MINIO_USE_SSL=false

# Alternative: AWS S3
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=eu-west-1
# AWS_S3_BUCKET=zengineering-files

# ==========================================
# JWT Authentication
# ==========================================
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# ==========================================
# Email / SMTP
# ==========================================
# Développement (MailHog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@zengineering.local
SMTP_FROM_NAME=Zen-gineering

# Production (SendGrid, AWS SES, etc.)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_sendgrid_api_key
# SMTP_FROM_EMAIL=noreply@yourdomain.com
# SMTP_FROM_NAME=Zen-gineering

# ==========================================
# IMAP (Réception emails)
# ==========================================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your_app_password
IMAP_TLS=true

# ==========================================
# Workflow Engine (built-in, no external service needed)
# ==========================================
# The workflow engine runs inside the NestJS backend.
# No external configuration required.

# ==========================================
# Frontend
# ==========================================
REACT_APP_API_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:3000
REACT_APP_UPLOAD_MAX_SIZE=104857600

# ==========================================
# Rate Limiting
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# File Upload
# ==========================================
UPLOAD_MAX_FILE_SIZE=104857600
UPLOAD_ALLOWED_MIME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/jpeg,image/png,image/gif

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=debug
LOG_FORMAT=json

# ==========================================
# Monitoring (optionnel)
# ==========================================
# SENTRY_DSN=your_sentry_dsn
# NEW_RELIC_LICENSE_KEY=your_new_relic_key
# NEW_RELIC_APP_NAME=Zen-gineering

# ==========================================
# Cors
# ==========================================
CORS_ORIGIN=http://localhost:3001

# ==========================================
# Session
# ==========================================
SESSION_SECRET=change_me_to_a_long_random_string_in_production
SESSION_MAX_AGE=86400000

# ==========================================
# Feature Flags
# ==========================================
FEATURE_CHAT_ENABLED=true
FEATURE_EMAIL_INTEGRATION_ENABLED=true
FEATURE_WORKFLOW_ENABLED=true
FEATURE_REPORTING_ENABLED=true

# ==========================================
# Backup
# ==========================================
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
