generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// User & Project (minimal models)
// ==========================================

enum Discipline {
  PROCESS
  PIPING
  ELECTRICAL
  INSTRUMENTATION
  CIVIL
  MECHANICAL
}

model User {
  id         String      @id @default(uuid())
  email      String      @unique
  name       String
  password   String
  role       String      @default("member") // admin, manager, member
  discipline Discipline?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  assignedSteps  WorkflowStep[]
  projects       ProjectMember[]
  discussions    Discussion[]
  comments       Comment[]
  changeRequests ChangeRequest[]
  documents      Document[]
  ownedDocumentEntries  DocumentRegisterEntry[] @relation("DocumentOwner")
  issuedDocumentEntries DocumentRegisterEntry[] @relation("DocumentIssuer")
  transmittals      Transmittal[]
  searchQueries     SearchQuery[]
  contractItems     ContractItem[]  @relation("ContractItemAssignee")
  dataOriginValidations DataOrigin[] @relation("DataOriginValidator")
  emailAssignments  IncomingEmail[]  @relation("EmailAssignee")
  emailRouteTargets EmailRoutingRule[] @relation("EmailRouteTargetUser")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("active") // active, archived, completed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clientName    String?
  clientContact String?
  projectEmail  String?

  members         ProjectMember[]
  partners        ProjectPartner[]
  projectVendors  ProjectVendor[]
  workflows       WorkflowInstance[]
  equipment       Equipment[]
  discussions     Discussion[]
  documents       Document[]
  documentEntries DocumentRegisterEntry[]
  transmittals    Transmittal[]
  incomingEmails  IncomingEmail[]
  searchQueries   SearchQuery[]
  contractItems      ContractItem[]
  emailRoutingRules  EmailRoutingRule[]
}

model ProjectMember {
  id        String @id @default(uuid())
  projectId String
  userId    String
  role      String @default("member") // owner, manager, member

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

// ==========================================
// Workflow Engine
// ==========================================

model WorkflowDefinition {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  steps       Json     // Array of step definitions: [{name, order, type, assigneeRole}]
  transitions Json     // Array of transitions: [{from, to, condition}]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  instances WorkflowInstance[]
}

model WorkflowInstance {
  id             String   @id @default(uuid())
  definitionId   String
  projectId      String?
  status         String   @default("running") // running, completed, cancelled, failed
  currentStepIdx Int      @default(0)
  context        Json?    // Arbitrary workflow data (document ID, metadata, etc.)
  startedAt      DateTime @default(now())
  completedAt    DateTime?

  definition    WorkflowDefinition @relation(fields: [definitionId], references: [id])
  project       Project?            @relation(fields: [projectId], references: [id])
  steps         WorkflowStep[]
  changeRequest ChangeRequest?
  incomingEmail IncomingEmail?
}

model WorkflowStep {
  id         String    @id @default(uuid())
  instanceId String
  name       String
  order      Int
  status     String    @default("pending") // pending, active, completed, rejected, skipped
  assigneeId String?
  action     String?   // approve, reject, complete, skip
  comment    String?
  startedAt  DateTime?
  completedAt DateTime?
  createdAt  DateTime  @default(now())

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  assignee User?            @relation(fields: [assigneeId], references: [id])
}

// ==========================================
// Equipment
// ==========================================

enum EquipmentCategory {
  VESSEL
  HEAT_EXCHANGER
  ROTATING_MACHINE
  MISCELLANEOUS
}

model Equipment {
  id                   String            @id @default(uuid())
  tagNumber            String            @unique
  service              String
  category             EquipmentCategory
  subType              String?
  quantity             Int               @default(1)
  material             String?
  operatingPressure    Float?
  operatingTemperature Float?
  designPressure       Float?
  designTemperature    Float?
  estimatedWeight      Float?
  size                 String?
  notes                String?
  projectId            String
  project              Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  discussions    Discussion[]
  changeRequests ChangeRequest[]
  documents      Document[]
  dataOrigins    DataOrigin[]
}

// ==========================================
// Change Requests
// ==========================================

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ChangeRequest {
  id                 String              @id @default(uuid())
  equipmentId        String
  requesterId        String
  fieldName          String
  oldValue           String?
  newValue           String
  justification      String?
  status             ChangeRequestStatus @default(PENDING)
  workflowInstanceId String?             @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  equipment        Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  requester        User              @relation(fields: [requesterId], references: [id])
  workflowInstance WorkflowInstance?  @relation(fields: [workflowInstanceId], references: [id])
}

// ==========================================
// Vendors (approved supplier list)
// ==========================================

model Vendor {
  id           String  @id @default(uuid())
  name         String  @unique
  country      String?
  contactEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  specialties    VendorEquipmentType[]
  documents      Document[]
  projectVendors ProjectVendor[]
  transmittals   Transmittal[]
}

model VendorEquipmentType {
  id            String @id @default(uuid())
  vendorId      String
  equipmentType String // e.g. "Centrifugal Pumps", "Ball Valves", "Control Valves"

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, equipmentType])
}

// ==========================================
// Discussions (internal blog / forum)
// ==========================================

model Discussion {
  id          String      @id @default(uuid())
  title       String
  content     String
  authorId    String
  projectId   String
  equipmentId String?

  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  equipment Equipment?  @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  comments  Comment[]
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id           String @id @default(uuid())
  content      String
  authorId     String
  discussionId String

  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  documents  Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// Documents (file management)
// ==========================================

enum DocumentCategory {
  DATASHEET
  SPECIFICATION
  DRAWING
  CERTIFICATION
  QUOTE
  REPORT
  MANUAL
  OTHER
}

enum DocumentFolder {
  CONTRACT
  CLIENT_SPECS
  ENGINEERING
  EMAILS
  OTHER
}

model Document {
  id          String           @id @default(uuid())
  fileName    String
  fileSize    Int
  mimeType    String
  s3Key       String           @unique
  category    DocumentCategory @default(OTHER)
  folder      DocumentFolder   @default(OTHER)
  description String?

  uploadedById String
  uploadedBy   User    @relation(fields: [uploadedById], references: [id])
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  equipmentId  String?
  equipment    Equipment?  @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  vendorId     String?
  vendor       Vendor?     @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  discussionId String?
  discussion   Discussion? @relation(fields: [discussionId], references: [id], onDelete: SetNull)
  commentId    String?
  comment      Comment?    @relation(fields: [commentId], references: [id], onDelete: SetNull)

  registerEntryId String?
  registerEntry   DocumentRegisterEntry? @relation(fields: [registerEntryId], references: [id], onDelete: SetNull)

  incomingEmailId String?
  incomingEmail   IncomingEmail? @relation(fields: [incomingEmailId], references: [id], onDelete: SetNull)

  transmittalItems TransmittalItem[]
  contractItems    ContractItem[]
  dataOrigins      DataOrigin[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// Project Partners & Vendors
// ==========================================

model ProjectPartner {
  id           String  @id @default(uuid())
  projectId    String
  name         String
  role         String? // e.g. "EPC Contractor", "Licensor", "FEED Engineer"
  contactName  String?
  contactEmail String?

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transmittals Transmittal[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ProjectVendor {
  id        String  @id @default(uuid())
  projectId String
  vendorId  String
  notes     String? // e.g. "Selected for pumps", "Under evaluation"

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, vendorId])
}

// ==========================================
// Document Register (formal deliverables)
// ==========================================

enum DocRegisterStatus {
  DRAFT
  FOR_REVIEW
  FOR_APPROVAL
  APPROVED
  SUPERSEDED
  CANCELLED
}

model DocumentRegisterEntry {
  id             String           @id @default(uuid())
  projectId      String
  documentNumber String           // e.g. "ZG-125-PRC-001"
  title          String
  discipline     Discipline
  ownerId        String
  issuerId       String?
  revision       String           @default("A")
  status         DocRegisterStatus @default(DRAFT)
  issueDate      DateTime?
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner     User       @relation("DocumentOwner", fields: [ownerId], references: [id])
  issuer    User?      @relation("DocumentIssuer", fields: [issuerId], references: [id])
  revisions Document[]
  transmittalItems TransmittalItem[]
  dataOrigins      DataOrigin[]

  @@unique([projectId, documentNumber])
}

// ==========================================
// Email & Document Exchange
// ==========================================

enum TransmittalPurpose {
  FOR_REVIEW
  FOR_APPROVAL
  FOR_INFORMATION
  FOR_CONSTRUCTION
  AS_BUILT
}

enum TransmittalStatus {
  DRAFT
  SENT
  ACKNOWLEDGED
}

enum IncomingEmailStatus {
  UNREAD
  READ
  ARCHIVED
}

enum EmailPurpose {
  INFORMATION
  QUERY
  DOCUMENT_SUBMISSION
  COMMENT_REQUEST
  OTHER
}

enum EmailDocumentIntent {
  FOR_INFORMATION
  AS_INPUT
  FOR_COMMENTS
}

model Transmittal {
  id                 String             @id @default(uuid())
  projectId          String
  transmittalNumber  String             // e.g. "ZG-125-TR-001"
  subject            String
  purpose            TransmittalPurpose
  recipientName      String
  recipientEmail     String
  recipientType      String             // VENDOR, PARTNER, CLIENT, OTHER
  vendorId           String?
  partnerId          String?
  coverLetter        String?
  sentById           String
  sentAt             DateTime?
  status             TransmittalStatus  @default(DRAFT)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sentBy   User            @relation(fields: [sentById], references: [id])
  vendor   Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  partner  ProjectPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  items    TransmittalItem[]

  @@unique([projectId, transmittalNumber])
}

model TransmittalItem {
  id              String  @id @default(uuid())
  transmittalId   String
  documentId      String?
  registerEntryId String?
  remarks         String?

  transmittal   Transmittal            @relation(fields: [transmittalId], references: [id], onDelete: Cascade)
  document      Document?              @relation(fields: [documentId], references: [id], onDelete: SetNull)
  registerEntry DocumentRegisterEntry? @relation(fields: [registerEntryId], references: [id], onDelete: SetNull)
}

model IncomingEmail {
  id              String              @id @default(uuid())
  projectId       String
  messageId       String              @unique // IMAP Message-ID for dedup
  fromAddress     String
  fromName        String?
  toAddress       String
  subject         String
  bodyText        String?
  bodyHtml        String?
  receivedAt      DateTime
  status          IncomingEmailStatus @default(UNREAD)
  purpose         EmailPurpose?
  documentIntent  EmailDocumentIntent?
  isExternal      Boolean             @default(false)
  notes           String?
  assignedToId    String?
  routedVia       String?             // "rule:<name>" or "auto:partner" or "auto:vendor" or "auto:discipline"
  workflowInstanceId String?          @unique
  createdAt       DateTime            @default(now())

  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachments      Document[]
  assignedTo       User?              @relation("EmailAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  workflowInstance WorkflowInstance?  @relation(fields: [workflowInstanceId], references: [id], onDelete: SetNull)
}

// ==========================================
// Search Queries (log + saved bookmarks)
// ==========================================

model SearchQuery {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  name      String?  // null = log entry, non-null = saved bookmark
  query     String   // The text query
  filters   Json?    // Stored filter state
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// Contract Management
// ==========================================

enum ContractItemType {
  REQUIREMENT // Contract reading / requirements register (project start)
  CHANGE      // Contract change log (project execution)
}

enum ContractItemStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  COMPLIANT
  NON_COMPLIANT
  WAIVED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ON_HOLD
}

enum ContractItemPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ContractImpact {
  NONE
  MINOR
  MODERATE
  MAJOR
}

model ContractItem {
  id          String              @id @default(uuid())
  projectId   String
  type        ContractItemType
  itemNumber  String              // e.g. "CR-001" or "CCL-001"

  // Core fields (from the "fiche de lecture" pattern)
  title       String              // Domain / topic
  description String?             // Detailed text / requirement description
  clauseRef   String?             // e.g. "Chap. 4.2.1" - contract clause reference
  specTitle   String?             // Referenced specification title
  docRef      String?             // Document reference number
  docRevision String?             // Document revision
  docPage     String?             // Page reference (e.g. "P 11/36")

  status      ContractItemStatus  @default(OPEN)
  priority    ContractItemPriority @default(MEDIUM)
  discipline  Discipline?
  assigneeId  String?
  dueDate     DateTime?
  notes       String?
  tags        String?             // comma-separated tags

  // REQUIREMENT-specific: reading sheet fields
  reqCategory String?             // Domain: Contractual, Donnees locales, Projet, etc.
  reqAction   String?             // Required action / response
  consequence String?             // Impact / consequence if not addressed
  scopeLimit  String?             // Scope boundaries / limits

  // CHANGE-specific fields
  changeRequestedBy String?       // Who requested the change
  changeDate        DateTime?     // Date change was requested
  commercialImpact  ContractImpact @default(NONE)
  commercialValue   Float?        // Monetary impact
  scheduleImpact    ContractImpact @default(NONE)
  scheduleDays      Int?          // Schedule impact in days
  technicalImpact   String?       // Free text technical impact
  clientRef         String?       // Client's reference number
  deviationType     String?       // e.g. "Clarif", "ds offre technique", "note"

  // Document link
  documentId  String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?     @relation("ContractItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([projectId, itemNumber])
  @@index([projectId, type])
}

// ==========================================
// Data Origin (AGO -- Approved & Guaranteed Origin)
// ==========================================

model DataOrigin {
  id               String    @id @default(uuid())
  equipmentId      String
  fieldName        String    // "designPressure", "material", etc.
  fieldValue       String    // snapshot of value at validation time
  sourceEntryId    String?   // -> DocumentRegisterEntry (formal doc)
  sourceDocumentId String?   // -> Document (uploaded file, if no register entry)
  sourceRef        String?   // free-text doc reference (fallback)
  sourceRevision   String?   // revision at time of validation
  sourceIssueDate  DateTime? // issue date of the source document
  sourcePage       String?   // page/clause reference
  validatedById    String
  validatedAt      DateTime  @default(now())
  notes            String?
  createdAt        DateTime  @default(now())

  equipment      Equipment              @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  sourceEntry    DocumentRegisterEntry? @relation(fields: [sourceEntryId], references: [id], onDelete: SetNull)
  sourceDocument Document?              @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  validatedBy    User                   @relation("DataOriginValidator", fields: [validatedById], references: [id])

  @@index([equipmentId, fieldName])
}

// ==========================================
// Email Routing Rules
// ==========================================

enum EmailRouteTarget {
  PROJECT_MANAGER
  DISCIPLINE_LEAD
  PROCUREMENT
  SPECIFIC_USER
}

model EmailRoutingRule {
  id               String              @id @default(uuid())
  projectId        String
  priority         Int                 @default(0)  // higher = evaluated first
  name             String
  senderDomain     String?             // e.g. "clientcorp.com"
  senderEmail      String?             // exact email match
  subjectContains  String?             // keyword in subject
  isExternal       Boolean?            // match external only
  target           EmailRouteTarget
  targetUserId     String?             // for SPECIFIC_USER
  targetDiscipline Discipline?         // for DISCIPLINE_LEAD
  autoPurpose      EmailPurpose?       // auto-set purpose
  autoIntent       EmailDocumentIntent? // auto-set document intent
  active           Boolean             @default(true)
  createdAt        DateTime            @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  targetUser User?   @relation("EmailRouteTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
}
