# ============================================================
# Zen-gineering v3.3 — Configuration NAS Production
# Copiez ce fichier en .env et adaptez les valeurs
# ============================================================

# ── Base de données ──────────────────────────────────────
POSTGRES_DB=zengineering
POSTGRES_USER=zengineering
POSTGRES_PASSWORD=ZenG_Prod_2026!

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=changez-ce-secret-jwt-en-production-32chars-min

# ── MinIO (stockage fichiers) ────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=ZenG_Minio_2026!
MINIO_BUCKET=zengineering-files

# ── SMTP sortant ─────────────────────────────────────────
# Mode MailHog (test) — pas de config supplémentaire
# Pour SMTP réel, décommenter et remplir :
# SMTP_HOST=smtp.votredomaine.com
# SMTP_PORT=587
# SMTP_USER=noreply@votredomaine.com
# SMTP_PASS=votre-mot-de-passe-smtp
# SMTP_FROM=noreply@votredomaine.com

# ── IMAP entrant (optionnel) ─────────────────────────────
# Désactivé si non configuré — le backend démarre normalement
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=votre.email@gmail.com
# IMAP_PASSWORD=votre-app-password-gmail
# IMAP_TLS=true
# IMAP_POLL_INTERVAL_MS=300000
